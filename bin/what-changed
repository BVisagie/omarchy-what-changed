#!/bin/bash
# what-changed — what actually landed on this machine after `omarchy update`.
#
# Sessions come out of /var/log/pacman.log. omarchy-update-keyring always runs
# `pacman -Sy --noconfirm archlinux-keyring`, so that invocation marks the head
# of every `omarchy update`. Everything up to the next one is a single session,
# however many pacman transactions it took. Recognition and completion-marker
# inference below distinguish primary changes from uncertain nearby activity.

set -euo pipefail

readonly SCHEMA_VERSION=1
readonly REPO="omacom/omarchy"
readonly API_HOST="api.github.com"
readonly MAX_ROWS=500
# How long after its last owned transaction a session may still claim one more.
# An update is a contiguous run; it does not own the days that follow it.
OWN_WINDOW=${WHAT_CHANGED_OWN_WINDOW:-3600}
readonly MAX_FETCH=524288      # cap on a single release body fetched from GitHub
readonly MAX_STDOUT=524288     # cap on anything this CLI prints

PACMAN_LOG=${WHAT_CHANGED_PACMAN_LOG:-/var/log/pacman.log}
OMARCHY_STATE=${WHAT_CHANGED_STATE_DIR:-$HOME/.local/state/omarchy}
CACHE_DIR=${WHAT_CHANGED_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/io.github.bvisagie.what-changed}
STATE_DIR=${WHAT_CHANGED_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/io.github.bvisagie.what-changed}
MARKER="$STATE_DIR/last-read"

# An empty history is not a failure of the same kind as an unreadable log, and
# the overlay has to tell them apart to say something true. Reserve one code for
# it rather than making callers pattern-match the message.
readonly EXIT_NO_SESSIONS=3

die() { printf 'what-changed: %s\n' "$*" >&2; exit 1; }
die_no_sessions() { printf 'what-changed: %s\n' "$*" >&2; exit "$EXIT_NO_SESSIONS"; }

# The plugin version lives in manifest.json and nowhere else, so the two can
# never drift.
plugin_version() {
  local manifest
  manifest="$(dirname "$(readlink -f "$0")")/../manifest.json"
  [[ -r $manifest ]] || { echo unknown; return; }
  jq -r '.version // "unknown"' "$manifest" 2>/dev/null || echo unknown
}

# Every command prints through here, so the output cap is stated once.
emit() {
  local out="$1"
  (( ${#out} <= MAX_STDOUT )) ||
    die "output exceeds ${MAX_STDOUT} bytes; narrow the request"
  printf '%s\n' "$out"
}

usage() {
  cat <<'USAGE'
Usage: what-changed [--json] [<command>] [args]

Commands:
  sessions              List recent `omarchy update` sessions, newest first
  show [id]             What landed on this machine (default command)
  notes [id]            Omarchy release notes for that session's version jump
  compare-url [id]      Print the GitHub compare URL for the version jump
  status                Newest session, and whether it has been read yet
  mark-read [id]        Record a session as read (default: the newest)

Options:
  --json                Machine-readable output
  --expand <group>      Include items of a collapsed group (show only)
  -h, --help            This text

A session id may be given in full or as a unique prefix; where a prefix matches
more than one session the newest match wins.

Exit status: 0 on success, 3 when the log holds no update sessions yet, 1 for
every real failure (missing or unreadable log, bad arguments).

Sessions are read from /var/log/pacman.log. Reading never needs sudo and never
touches the pacman lock. The only thing written is the read-marker under
$XDG_STATE_HOME/io.github.bvisagie.what-changed/, and the release-note cache.
USAGE
}

# ---------------------------------------------------------------- log parsing

# One JSON object per session on stdout, oldest first. Package names and
# versions are escaped and length-capped here: everything downstream, including
# the QML overlay, treats this as untrusted text.
parse_log() {
  [[ -e $PACMAN_LOG ]] || die "pacman log not found: $PACMAN_LOG"
  [[ -r $PACMAN_LOG ]] || die "pacman log is not readable: $PACMAN_LOG"

  awk -v ownwindow="$OWN_WINDOW" '
    function jesc(s) {
      gsub(/\\/, "\\\\", s)
      gsub(/"/, "\\\"", s)
      gsub(/[[:cntrl:]]/, " ", s)
      return s
    }
    function cap(s, n) { return length(s) > n ? substr(s, 1, n) : s }
    function field(s, n) { return jesc(cap(s, n)) }

    # [2026-09-08T20:41:29+0200] -> epoch seconds.
    function epoch_of(ts,   d, off, sign, oh, om, e) {
      if (ts !~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$/) return -1
      d = sprintf("%s %s %s %s %s %s", substr(ts,1,4), substr(ts,6,2), substr(ts,9,2), \
                  substr(ts,12,2), substr(ts,15,2), substr(ts,18,2))
      e = mktime(d, 1)
      if (e < 0) return -1
      sign = substr(ts, 20, 1); oh = substr(ts, 21, 2) + 0; om = substr(ts, 23, 2) + 0
      off = oh * 3600 + om * 60
      return sign == "-" ? e + off : e - off
    }

    # Recognition admits only known update commands to the rolling window.
    # All other transactions are recorded first, then bounded and attributed
    # using completion markers. A nearby command never extends ownership.
    function is_update_cmd(c) {
      if (c == "pacman -Sy --noconfirm archlinux-keyring") return 1              # update-keyring
      if (c ~ /^pacman -S --noconfirm --needed (-- )?omarchy-keyring$/) return 1        # update-keyring, first run
      if (index(c, "pacman -Syu ") == 1 &&
          index(c, "--overwrite /usr/share/omarchy/*") > 0) return 1             # update-system-pkgs
      if (index(c, "pacman -U") == 1 && index(c, "--config /etc/pacman.conf") > 0 &&
          (index(c, "/.cache/yay/") > 0 || index(c, "/.cache/paru/") > 0)) {
        # `omarchy pkg aur add` runs `yay -S --noconfirm --needed`, which
        # reaches pacman wearing the same shape as the AUR step of an update.
        # An update runs `yay -Sua`, upgrading what is already installed, so
        # it never passes --needed. That flag separates the two.
        return index(c, "--needed") == 0
      }
      if (index(c, "pacman -D ") == 1 &&
          index(c, "--config /etc/pacman.conf") > 0) return 1                    # yay, mark explicit
      # update-orphan-pkgs runs `sudo pacman -Rns <orphans>`; `omarchy pkg
      # remove` always passes --noconfirm. That is the whole difference.
      if (index(c, "pacman -Rns ") == 1 && index(c, "--noconfirm") == 0) return 1
      return 0
    }

    function flush_command(   i, sep) {
      if (!started || !have_command) return
      if (own && tx_started > tx_done) incomplete = 1
      if (system_command) system_end = (tx_started > 0 && tx_started == tx_done ? tx_end : -1)
      commands[++ncmd] = sprintf("{\"owned\":%s,\"startedEpoch\":%d,\"finishedEpoch\":%d,\"complete\":%s,\"events\":[",
        own ? "true" : "false", cmd_epoch, tx_end,
        (tx_started > 0 && tx_started == tx_done ? "true" : "false"))
      sep = ""
      for (i = 1; i <= nev; i++) { commands[ncmd] = commands[ncmd] sep ev[i]; sep = "," }
      commands[ncmd] = commands[ncmd] "]}"
      have_command = 0
    }

    function flush_session(   i, sep) {
      if (!started) return
      flush_command()
      printf "{\"startedAt\":\"%s\",\"finishedAt\":\"%s\",\"startedEpoch\":%d,\"finishedEpoch\":%d,",
        jesc(s_start), jesc(s_last), s_start_epoch, s_last_epoch
      printf "\"id\":\"%s\",\"incomplete\":%s,\"systemCompletedEpoch\":%d,\"commands\":[",
        s_id, (incomplete ? "true" : "false"), system_end
      sep = ""
      for (i = 1; i <= ncmd; i++) { printf "%s%s", sep, commands[i]; sep = "," }
      printf "]}\n"
    }

    function reset_session(ts) {
      flush_session()
      started = 1; s_start = ts; s_last = ts
      s_start_epoch = epoch_of(ts); s_last_epoch = s_start_epoch
      s_id = s_start_epoch >= 0 ? strftime("%Y%m%dT%H%M%SZ", s_start_epoch, 1) : "unknown"
      ncmd = 0; incomplete = 0; system_end = -1
      own_until = (s_start_epoch >= 0 ? s_start_epoch + ownwindow : 0)
      delete commands
    }

    {
      if (substr($0, 1, 1) != "[") next
      close_ts = index($0, "] ")
      if (close_ts < 3) next
      ts = substr($0, 2, close_ts - 2)
      rest = substr($0, close_ts + 2)
      if (substr(rest, 1, 1) != "[") next
      close_cat = index(rest, "] ")
      if (close_cat < 3) next
      cat = substr(rest, 2, close_cat - 2)
      rest = substr(rest, close_cat + 2)
    }

    cat == "PACMAN" && substr(rest, 1, 8) == "Running " {
      cmd = substr(rest, 9)
      if (length(cmd) >= 2) cmd = substr(cmd, 2, length(cmd) - 2)
      if (cmd == "pacman -Sy --noconfirm archlinux-keyring") reset_session(ts)
      else flush_command()
      if (!started) next
      e = epoch_of(ts)
      own = is_update_cmd(cmd) && (e < 0 || own_until <= 0 || e <= own_until)
      system_command = own && index(cmd, "pacman -Syu ") == 1
      aur = (index(cmd, "pacman -U") == 1 &&
             (index(cmd, "/.cache/yay/") > 0 || index(cmd, "/.cache/paru/") > 0))
      have_command = 1; cmd_epoch = e; tx_end = -1
      tx_started = 0; tx_done = 0; nev = 0; delete ev
      if (own) {
        s_last = ts
        if (e >= 0) { s_last_epoch = e; own_until = e + ownwindow }
      }
      next
    }

    !started || !have_command { next }

    {
      e = epoch_of(ts)
      if (own) {
        s_last = ts
        if (e >= 0) { s_last_epoch = e; own_until = e + ownwindow }
      }
    }

    cat != "ALPM" { next }
    rest == "transaction started" { tx_started++; next }
    rest == "transaction completed" { tx_done++; tx_end = e; next }

    {
      sp = index(rest, " ")
      if (sp == 0) next
      op = substr(rest, 1, sp - 1)
      if (op != "upgraded" && op != "installed" && op != "removed" &&
          op != "downgraded" && op != "reinstalled") next
      tail = substr(rest, sp + 1)
      op_par = index(tail, " (")
      if (op_par == 0 || substr(tail, length(tail), 1) != ")") next
      name = substr(tail, 1, op_par - 1)
      vers = substr(tail, op_par + 2, length(tail) - op_par - 2)
      if (name !~ /^[A-Za-z0-9@._+-]+$/) next
      from = ""; to = ""
      arrow = index(vers, " -> ")
      if (arrow > 0) { from = substr(vers, 1, arrow - 1); to = substr(vers, arrow + 4) }
      else if (op == "removed") from = vers
      else to = vers
      ev[++nev] = sprintf("{\"op\":\"%s\",\"name\":\"%s\",\"from\":\"%s\",\"to\":\"%s\",\"aur\":%s,\"occurredAt\":\"%s\",\"epoch\":%d}",
        op, field(name, 128), field(from, 64), field(to, 64),
        (aur ? "true" : "false"), field(ts, 32), e)
    }
    END { flush_session() }
  ' "$PACMAN_LOG"
}

# Migration markers whose mtime lands inside a session window. omarchy-migrate
# touches ~/.local/state/omarchy/migrations/<id>.sh after each succeeds, so the
# mtimes survive the update that wrote them.
migrations_json() {
  local dir="$OMARCHY_STATE/migrations"
  [[ -d $dir && -r $dir ]] || { echo null; return; }
  # The id goes straight into JSON, so anything that is not a plain migration
  # id is skipped rather than escaped: a stray quote would break the whole
  # document, and jq failing here would silently drop every migration.
  find "$dir" -maxdepth 1 -type f -name '*.sh' -printf '%T@\t%f\n' 2>/dev/null |
    awk -F'\t' '{
      sub(/\.sh$/, "", $2)
      if ($2 ~ /^[A-Za-z0-9._-]+$/)
        printf "{\"epoch\":%d,\"id\":\"%s\"}\n", $1, $2
    }' |
    jq -s '.' 2>/dev/null || echo null
}

omarchy_channel() {
  command -v omarchy-channel-current >/dev/null 2>&1 &&
    omarchy-channel-current 2>/dev/null | head -1 || echo unknown
}

# How a package name is bucketed. Defined once and interpolated into both jq
# programs below, so the two can never drift apart.
#
# Unanchored prefixes were grouping libraries as applications: "code" caught
# codec2, "vim" caught vim-runtime, "mesa" put mesa-utils under Needs reboot.
# A prefix is kept only where the suffix is genuinely part of the product
# (brave-origin-bin, docker-compose, nvidia-utils); everything else is matched
# exactly, allowing the -bin and -git suffixes that AUR builds carry.
readonly JQ_CLASSES='
  def rebootClass:
    test("^(linux|linux-lts|linux-zen|linux-hardened|linux-rt|linux-rt-lts|linux-omarchy|linux-t2)$")
    or test("^linux-firmware(-|$)")
    or test("^nvidia(-|$)")
    or test("^(mesa|amdgpu)$");

  def omarchyClass:
    . == "omarchy" or . == "omarchy-dev"
    or . == "omarchy-settings" or . == "omarchy-settings-dev"
    or . == "omarchy-keyring";

  def appClass:
    test("^(brave|firefox|chromium|google-chrome|microsoft-edge|vivaldi|librewolf)(-|$)")
    or test("^(docker|podman|containerd)(-|$)")
    or test("^(cursor|vscodium|neovim)(-|$)")
    or test("^(code|vim|zed|helix|emacs|nvim)(-bin|-git)?$")
    or test("^(foot|alacritty|kitty|ghostty|wezterm)(-bin|-git)?$")
    or test("^(hyprland|hypridle|hyprlock|hyprpaper|hyprsunset|hyprpicker|quickshell|waybar|xdg-desktop-portal-hyprland)$")
    or test("^(obsidian|spotify|discord|signal-desktop|telegram-desktop|slack|zoom|thunderbird|1password|bitwarden)(-|$)")
    or test("^(obs-studio|gimp|inkscape|blender|krita|vlc|mpv|steam|lutris|localsend)(-|$)")
    or test("^(mise|git|gh|lazygit|lazydocker|tmux|fastfetch)(-bin|-git)?$");
  def bucket:
    if .attribution == "nearby-uncertain" then "nearby"
    elif (.name | omarchyClass) then "omarchy"
    elif (.name | rebootClass) then "reboot"
    elif .attribution == "migration-inferred" then "migration-packages"
    elif (.name | appClass) then "apps"
    elif .aur then "aur"
    else "other" end;
'

# ------------------------------------------------------- session enrichment

# Boot time qualifies package-based inference. The live marker is a separate
# current system request: restart-shell does not clear it, and unrelated
# actions can create it. Reboot/shutdown clear it; other boot paths may not.
boot_epoch() {
  local value
  value=$(awk '$1 == "btime" && $2 ~ /^[0-9]+$/ { print $2; exit }' \
    "${WHAT_CHANGED_PROC_STAT:-/proc/stat}" 2>/dev/null) || value=""
  [[ $value =~ ^[0-9]+$ ]] && printf '%s' "$value" || printf null
}

reboot_marker_epoch() {
  [[ -f $OMARCHY_STATE/reboot-required ]] || { printf null; return; }
  local value
  value=${WHAT_CHANGED_REBOOT_MARKER_EPOCH-$(stat -c %Y "$OMARCHY_STATE/reboot-required" 2>/dev/null || true)}
  [[ $value =~ ^[0-9]+$ ]] && printf '%s' "$value" || printf null
}

enrich_sessions() {
  local migrations channel boot marker marker_exists=false
  migrations=$(migrations_json)
  channel=$(omarchy_channel)
  boot=$(boot_epoch)
  marker=$(reboot_marker_epoch)
  [[ -f $OMARCHY_STATE/reboot-required ]] && marker_exists=true

  parse_log | jq -s \
    --argjson schema "$SCHEMA_VERSION" \
    --argjson migrations "$migrations" \
    --argjson boot "$boot" --argjson marker "$marker" \
    --argjson markerExists "$marker_exists" \
    --argjson maxRows "$MAX_ROWS" \
    --arg channel "$channel" --arg thisYear "$(date +%Y)" "$JQ_CLASSES"'

  def humanLabel($iso):
    ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"] as $months
    | $iso[0:4] as $y
    | (try ($iso[5:7] | tonumber) catch 0) as $mo
    | (try ($iso[8:10] | tonumber) catch 0) as $d
    | if $mo < 1 or $mo > 12 then $iso[0:16]
      else "\($d) \($months[$mo - 1]) "
           + (if $y == $thisYear then "" else "\($y) " end) + $iso[11:16]
      end;

  def release: sub("-[0-9]+$"; "");
  def supportedJump($from; $to):
    ($from | release) as $f | ($to | release) as $t
    | ($f | test("^[0-9]+\\.[0-9]+\\.[0-9]+$"))
      and ($t | test("^[0-9]+\\.[0-9]+\\.[0-9]+$")) and $f != $t;

  def counts:
    {upgraded: (map(select(.op == "upgraded")) | length),
     installed: (map(select(.op == "installed")) | length),
     removed: (map(select(.op == "removed")) | length),
     downgraded: (map(select(.op == "downgraded")) | length),
     reinstalled: (map(select(.op == "reinstalled")) | length),
     aur: (map(select(.aur)) | length), total: length, omitted: 0};

  # Priority facts use the same classifier as the groups. Keep recorded order
  # even when priority rows appear after the bulk display budget is exhausted.
  def displayed:
    map(. + {priority: ((.name | omarchyClass) or (.name | rebootClass))}) as $all
    | ($all | map(select(.priority)) | length) as $priority
    | ([$maxRows - $priority, 0] | max) as $room
    | foreach $all[] as $row ({bulk: 0, row: null};
        .row = $row | if $row.priority then . else .bulk += 1 end;
        if .row.priority or .bulk <= $room then .row | del(.priority, .epoch) else empty end);

  . as $raw
  | [range(0; $raw | length) as $i
      | $raw[$i] as $s
      | (if $i + 1 < ($raw | length) then $raw[$i+1].startedEpoch else null end) as $nextStart
      | ($s.finishedEpoch + 1800) as $graceEnd
      | (if $nextStart == null then $graceEnd else [$nextStart, $graceEnd] | min end) as $windowEnd
      | (if $migrations == null or $s.startedEpoch < 0 then null
         else $migrations | map(select(.epoch >= $s.startedEpoch and .epoch <= $graceEnd
                                      and ($nextStart == null or .epoch < $nextStart))) end) as $markers
      | (($markers // []) | map(.epoch) | max // -1) as $migrationEnd
      | [$s.commands[]
          # Sessions are split by log order before timestamps are considered.
          # Candidates must finish inside the fixed time window as well.
          | select(.owned or (.startedEpoch >= $s.startedEpoch and .startedEpoch >= 0
                              and .startedEpoch <= $windowEnd
                              and (all(.events[]; .epoch >= 0 and .epoch <= $windowEnd))
                              and (.finishedEpoch < 0 or .finishedEpoch <= $windowEnd)))
          | (if .owned then "update-command"
             elif .complete and $s.systemCompletedEpoch >= 0
                  and .startedEpoch >= $s.systemCompletedEpoch
                  and .finishedEpoch >= .startedEpoch and .finishedEpoch <= $migrationEnd
             then "migration-inferred" else "nearby-uncertain" end) as $attribution
          | .events[] | . + {attribution: $attribution, bucket: (. + {attribution: $attribution} | bucket)}
        ] as $events
      | ($events | map(select(.attribution != "nearby-uncertain"))) as $primary
      | ($events | map(select(.attribution == "nearby-uncertain"))) as $nearby
      | [$primary | displayed] as $shown
      | [$nearby | displayed] as $nearbyShown
      | ($primary | map(select(.name | rebootClass))) as $rebootEvents
      | ($rebootEvents | map(.epoch) | max // -1) as $lastRebootChange
      | (if ($rebootEvents | length) == 0 then "not-indicated"
         elif $boot == null or any($rebootEvents[]; .epoch < 0) or $lastRebootChange == $boot then "unknown"
         elif $lastRebootChange > $boot then "pending" else "rebooted" end) as $rebootStatus
      | {id: $s.id, startedAt: $s.startedAt, finishedAt: $s.finishedAt,
         label: humanLabel($s.startedAt), channel: $channel,
         incomplete: $s.incomplete, source: "pacman-log", isLatest: ($i == ($raw | length) - 1),
         rebootStatus: $rebootStatus, rebootRequired: ($rebootStatus == "pending"),
         rebootReason: ($rebootEvents | map(.name) | unique),
         migrations: (if $markers == null then null else $markers | map(.id) | sort end),
         counts: (($primary | counts) + {omitted: (($primary | length) - ($shown | length))}),
         nearbyCounts: (($nearby | counts) + {omitted: (($nearby | length) - ($nearbyShown | length))}),
         groupCounts: ($events | group_by(.bucket) | map({key: .[0].bucket, value: length}) | from_entries),
         versionEvents: ($primary | map(select(.name == "omarchy" or .name == "omarchy-dev"))),
         events: ($shown + $nearbyShown)}
    ]
  # A removal makes the carried version unknown. The currently installed package is
  # never substituted for missing historical evidence.
  | [foreach .[] as $s ({version: "", package: "omarchy", session: null};
       . as $state
       | (reduce $s.versionEvents[] as $e
           ({version: $state.version, package: $state.package, from: null};
            if .from == null then .from = (if $e.from != "" then $e.from else .version end) else . end
            | if $e.op == "removed" then
                if .package == $e.name or .version == "" then .version = "" end
              else .version = $e.to | .package = $e.name end)) as $v
       | {version: $v.version, package: $v.package,
          session: ($s | del(.versionEvents) | . + {omarchy:
            {package: $v.package, from: ($v.from // $v.version), to: $v.version,
             jumped: supportedJump(($v.from // $v.version); $v.version),
             jump: (if supportedJump(($v.from // $v.version); $v.version)
                    then "\($v.from) → \($v.version)" else null end)}})};
       .session)]
  | {schemaVersion: $schema, sessions: reverse,
     currentRebootRequest: (if $markerExists | not then "absent"
       elif $boot == null or $marker == null or $marker == $boot then "unknown"
       elif $marker < $boot then "stale" else "pending" end)}
  '
}

# Counts describe all observed rows, even when the displayed items are capped.
group_session() {
  local expand="${1:-}"
  jq --arg expand "$expand" "$JQ_CLASSES"'
  def row: {kind: "pkg", op: .op, name: .name, from: .from, to: .to,
            aur: .aur, attribution: .attribution, occurredAt: .occurredAt};
  . as $s
  | [ {id: "omarchy", title: "Omarchy"},
      {id: "reboot", title: "Reboot-related changes"},
      {id: "apps", title: "Apps"},
      {id: "migration-packages", title: "Migration package changes (inferred)",
       explanation: "Completion markers place these transactions in the migration phase. Concurrent manual commands cannot be ruled out."},
      {id: "migrations", title: "Migrations"},
      {id: "aur", title: "AUR"},
      {id: "other", title: "Other packages", collapsed: true},
      {id: "nearby", title: "Other changes during this window",
       explanation: "These transactions may come from migrations or manual commands. They are excluded from the update totals, version and reboot inference."}
    ]
  | map(. as $g
      | if .id == "migrations" then
          .items = (($s.migrations // []) | map({kind: "migration", name: .}))
          | .count = (.items | length)
          | .summary = (if .count == 1 then "1 migration ran" else "\(.count) migrations ran" end)
        else
          .items = ($s.events | map(select(.bucket == $g.id) | row) | sort_by(.name))
          | .count = ($s.groupCounts[.id] // 0)
          | .omitted = (.count - (.items | length))
          | if (.id == "omarchy" or .id == "reboot") and any(.items[]; .attribution == "migration-inferred") then
              .explanation = "Rows marked inferred fall within the migration completion bracket. Concurrent manual commands cannot be ruled out."
            else . end
          | if .id == "other" then
              .title = (if .count == 1 then "1 other package" else "\(.count) other packages" end)
              | if $expand == "other" then . else .items = [] end
            else . end
        end)
  | map(select(.id == "other" or .count > 0))
  | {schemaVersion: $s.schemaVersion, session: ($s | del(.events, .schemaVersion, .groupCounts)), groups: .}
  '
}

# ------------------------------------------------------------ release notes

# Release bodies retain the 1.0 cache behavior in this accuracy release. Tags
# are immutable, but descriptions can be edited; revalidation is future work.
# Requests use only validated release versions, never raw log text.
fetch_release() {
  local version="$1" cache
  [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  cache="$CACHE_DIR/releases/v$version.json"

  if [[ -s $cache ]]; then cat "$cache"; return 0; fi

  mkdir -p "$CACHE_DIR/releases"
  chmod 700 "$CACHE_DIR" "$CACHE_DIR/releases" 2>/dev/null || true

  local tmp body
  tmp=$(mktemp "$CACHE_DIR/releases/.fetch.XXXXXX") || return 1
  # shellcheck disable=SC2064
  trap "rm -f '$tmp'" RETURN

  # 2 means "the network said no", which the caller uses to stop walking the
  # rest of the tags. Offline, one 10s timeout is the honest cost of finding
  # out; twenty of them is a hung notes tab.
  if ! curl --silent --show-error --fail --location \
        --proto '=https' --max-redirs 1 --max-time 10 \
        --max-filesize "$MAX_FETCH" \
        -H 'Accept: application/vnd.github+json' \
        "https://$API_HOST/repos/$REPO/releases/tags/v$version" -o "$tmp" 2>/dev/null; then
    return 2
  fi

  body=$(jq -c '{ tag: (.tag_name // ""), name: (.name // ""),
                  url: (.html_url // ""), body: (.body // "") }' "$tmp" 2>/dev/null) || return 1
  [[ -n $body && $body != null ]] || return 1
  printf '%s\n' "$body" >"$cache"
  chmod 600 "$cache" 2>/dev/null || true
  printf '%s\n' "$body"
}

# A supported release may carry a numeric pacman pkgrel, never a dev suffix.
release_version() {
  [[ $1 =~ ^([0-9]+\.[0-9]+\.[0-9]+)(-[0-9]+)?$ ]] || return 1
  printf '%s' "${BASH_REMATCH[1]}"
}

# The tags between two omarchy package versions, inclusive of the destination.
# 4.0.2-1 -> 4.0.3-1 is one tag; a skipped release yields several, in order.
tags_between() {
  local from="$1" to="$2"
  local f t
  f=$(release_version "$from") || return 1
  t=$(release_version "$to") || return 1
  [[ $f =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $t =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [[ $f != "$t" ]] || return 1

  local fmaj fmin fpat tmaj tmin tpat
  IFS=. read -r fmaj fmin fpat <<<"$f"
  IFS=. read -r tmaj tmin tpat <<<"$t"

  # Only walk a patch run inside one minor series; anything wider just reports
  # the destination tag rather than inventing versions that may not exist.
  if (( fmaj == tmaj && fmin == tmin && tpat > fpat && tpat - fpat <= 20 )); then
    local p
    for (( p = fpat + 1; p <= tpat; p++ )); do printf '%s.%s.%s\n' "$tmaj" "$tmin" "$p"; done
  else
    printf '%s\n' "$t"
  fi
}

notes_json() {
  local session="$1" from to
  from=$(jq -r '.omarchy.from' <<<"$session")
  to=$(jq -r '.omarchy.to' <<<"$session")

  local tags
  if ! tags=$(tags_between "$from" "$to"); then
    jq -n --argjson s "$session" \
      '{ schemaVersion: 1, session: $s, status: "no-jump", releases: [],
         message: "No Omarchy version change in this session." }'
    return 0
  fi

  # Cache hits stay free, so keep reading tags until one actually has to go to
  # the network and fails. After that every remaining tag would pay the same
  # timeout to learn the same thing.
  local releases=() missing=0 offline=0 tag rc
  while IFS= read -r tag; do
    [[ -n $tag ]] || continue
    local rel
    if (( offline )) && [[ ! -s $CACHE_DIR/releases/v$tag.json ]]; then missing=1; continue; fi
    rc=0; rel=$(fetch_release "$tag") || rc=$?
    if (( rc == 0 )); then
      releases+=("$rel")
    else
      missing=1
      if (( rc == 2 )); then offline=1; fi
    fi
  done <<<"$tags"

  local joined
  joined=$(printf '%s\n' "${releases[@]+"${releases[@]}"}" | jq -s '[.[] | select(. != null)]')

  if [[ $(jq 'length' <<<"$joined") -eq 0 ]]; then
    jq -n --argjson s "$session" \
      '{ schemaVersion: 1, session: $s, status: "unavailable", releases: [],
         message: "Notes unavailable offline." }'
    return 0
  fi

  jq -n --argjson s "$session" --argjson r "$joined" --argjson partial "$missing" \
    '{ schemaVersion: 1, session: $s,
       status: (if $partial == 1 then "partial" else "ok" end),
       releases: $r,
       message: (if $partial == 1 then "Some release notes could not be fetched." else "" end) }'
}

# ------------------------------------------------------------- read marker

# One line naming the newest session the user has seen. Written by the overlay
# when it opens, read by the bar widget to decide whether it exists at all.
# Never fatal: a machine that cannot write state still shows every view.
read_marker() {
  [[ -r $MARKER ]] || return 1
  local id
  id=$(head -c 64 "$MARKER" 2>/dev/null | tr -d '[:space:]')
  [[ $id =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || return 1
  printf '%s' "$id"
}

write_marker() {
  local id="$1"
  [[ $id =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || return 1
  mkdir -p "$STATE_DIR" 2>/dev/null || return 1
  chmod 700 "$STATE_DIR" 2>/dev/null || true
  local tmp
  tmp=$(mktemp "$STATE_DIR/.last-read.XXXXXX" 2>/dev/null) || return 1
  printf '%s\n' "$id" >"$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$MARKER" 2>/dev/null || { rm -f "$tmp"; return 1; }
}

compare_url() {
  local from="$1" to="$2"
  local f t
  f=$(release_version "$from") || return 1
  t=$(release_version "$to") || return 1
  [[ $f =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $t =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $f != "$t" ]] || return 1
  printf 'https://github.com/%s/compare/v%s...v%s\n' "$REPO" "$f" "$t"
}

# --------------------------------------------------------------- rendering

readonly JQ_HELPERS='
  def pad($n): tostring as $s | if ($n - ($s | length)) > 0
    then $s + (" " * ($n - ($s | length))) else $s end;
  def stripRel: (. // "") | sub("-[0-9]+$"; "");
  # Upgrades are the default and reinstalls are almost always the keyring, so
  # neither earns a place in the summary. What stands out is what arrived and
  # what left.
  def countSummary:
    "\(.total) package" + (if .total == 1 then "" else "s" end) + " changed"
    + ([ (if .installed  > 0 then "\(.installed) added"       else empty end),
         (if .removed    > 0 then "\(.removed) removed"       else empty end),
         (if .downgraded > 0 then "\(.downgraded) downgraded" else empty end) ]
       | if length == 0 then "" else "  \u00b7  " + join("  \u00b7  ") end);
  def versionText:
    if .kind == "migration" then ""
    elif .op == "removed" then "removed \(.from)"
    elif .from != "" and .to != "" then "\(.from) → \(.to)"
    elif .op == "installed" then "installed \(.to)"
    elif .op == "reinstalled" then "reinstalled \(.to)"
    else .to end;
  def jumpText:
    if .omarchy.jumped then "omarchy \(.omarchy.from | stripRel) \u2192 \(.omarchy.to | stripRel)"
    elif .omarchy.to != "" then "omarchy \(.omarchy.to | stripRel)"
    else "omarchy version unknown" end;
'

render_sessions_text() {
  jq -r "$JQ_HELPERS"'
    .sessions[]
    | (.counts | [ (if .upgraded > 0 then "\(.upgraded)↑" else empty end),
                   (if .installed > 0 then "\(.installed)+" else empty end),
                   (if .removed > 0 then "\(.removed)-" else empty end),
                   (if .downgraded > 0 then "\(.downgraded)↓" else empty end),
                   (if .reinstalled > 0 then "\(.reinstalled)↻" else empty end) ]
             | join(" ")) as $c
    | ((.omarchy.from // "") | sub("-[0-9]+$"; "")) as $vf
    | ((.omarchy.to   // "") | sub("-[0-9]+$"; "")) as $vt
    | (if .omarchy.jumped then "\($vf) → \($vt)" else $vt end) as $v
    | "\(.label)  \($v | pad(18))\($c | pad(22))"
      + (if .rebootRequired then "reboot" else "" end)
      + (if .incomplete then "  (unfinished package transaction)" else "" end)
    | sub(" +$"; "")
  '
}

render_show_text() {
  jq -r "$JQ_HELPERS"'
    .session as $s
    | ([ $s.label, ($s | jumpText), (if $s.channel != "unknown" then "current channel: " + $s.channel else empty end),
         (if $s.rebootStatus == "pending" then "reboot needed"
          elif $s.rebootStatus == "rebooted" then "reboot followed these changes"
          elif $s.rebootStatus == "unknown" then "reboot-related changes; reboot status unknown" else empty end) ]
       | map(select(. != null and . != "")) | join("  ·  ")),
      ($s.counts | countSummary),
      (if .currentRebootRequest == "pending" then "Current system reboot request: pending."
       elif .currentRebootRequest == "unknown" then "Current system reboot request: applicability unknown." else empty end),
      (if $s.nearbyCounts.total > 0 then "\($s.nearbyCounts.total) other changes during this window (excluded from update totals)." else empty end),
      (if $s.incomplete then "\n! Unfinished package transaction. Pacman history cannot establish whole-update success." else empty end),
      ( .groups[]
        | . as $g
        | ($g.items | map(.name | length) | max // 0) as $w
        | (if $w > 30 then 30 else $w end) as $w
        | "",
          $g.title,
          (if $g.explanation then "  " + $g.explanation else empty end),
          ( if $g.summary then "  " + $g.summary
            elif $g.id == "other" and ($g.items | length) == 0
            then "  (what-changed show --expand other)"
            else ($g.items[] | "  \(.name | pad($w))  \(versionText)"
                  + (if .attribution == "migration-inferred" then " (inferred)" else "" end) | sub(" +$"; ""))
            end )
      ),
      (if $s.counts.omitted > 0 then "\n\($s.counts.omitted) further package rows omitted." else empty end),
      (if $s.nearbyCounts.omitted > 0 then "\n\($s.nearbyCounts.omitted) further nearby rows omitted." else empty end)
  '
}

render_notes_text() {
  jq -r '
    .session as $s
    | if .status == "no-jump" or .status == "unavailable" then .message
      else ( .releases[]
             | "── \(.name // .tag) ──────────────────────────────────────",
               "\(.url)", "", (.body // ""), "" ),
             (if .status == "partial" then .message else empty end)
      end
  '
}

# --------------------------------------------------------------- dispatcher

JSON=0
EXPAND=""
CMD=""
SESSION_ARG=""

while (( $# )); do
  case "$1" in
    --json)    JSON=1; shift ;;
    # ${2:-} would mask a missing argument and the shift 2 that followed would
    # then fail under `set -e`, killing the script before die could say why.
    --expand)
      [[ -n ${2:-} && $2 != -* ]] ||
        die "--expand requires a group name (try --expand other)"
      EXPAND=$2; shift 2 ;;
    --expand=*)
      EXPAND=${1#*=}
      [[ -n $EXPAND ]] || die "--expand requires a group name (try --expand other)"
      shift ;;
    -h|--help) usage; exit 0 ;;
    --version) printf 'what-changed %s\n' "$(plugin_version)"; exit 0 ;;
    --)        shift ;;
    -*)        die "unknown option: $1 (try --help)" ;;
    *)         if [[ -z $CMD ]]; then CMD=$1; else SESSION_ARG=$1; fi; shift ;;
  esac
done

# `what-changed 20260908T184129Z` is a session, not a command.
if [[ -n $CMD && $CMD =~ ^[0-9]{8}T[0-9]{6}Z$ ]]; then SESSION_ARG=$CMD; CMD=""; fi
CMD=${CMD:-show}

ALL=$(enrich_sessions)
SESSION_COUNT=$(jq '.sessions | length' <<<"$ALL")

# `status` is what the bar widget asks on a machine that may never have been
# updated, so it answers for an empty history instead of failing.
if (( SESSION_COUNT == 0 )) && [[ $CMD != status ]]; then
  die_no_sessions "no update sessions found in $PACMAN_LOG"
fi

# Newest by default. Otherwise a full id or a prefix; where a prefix matches
# more than one session the newest wins, which is what `show 2026` should mean.
pick_session() {
  local want="$1"
  if [[ -z $want || $want == latest ]]; then
    jq -c '.sessions[0]' <<<"$ALL"
    return
  fi
  local hits
  hits=$(jq -c --arg w "$want" '[.sessions[] | select(.id == $w or (.id | startswith($w)))]' <<<"$ALL")
  (( $(jq 'length' <<<"$hits") > 0 )) || die "no session matching: $want"
  jq -c '.[0]' <<<"$hits"
}

case "$CMD" in
  sessions)
    if (( JSON )); then
      emit "$(jq -c '{ schemaVersion: .schemaVersion,
                       currentRebootRequest: .currentRebootRequest,
                       sessions: [ .sessions[] | del(.events, .groupCounts) ] }' <<<"$ALL")"
    else
      render_sessions_text <<<"$ALL"
    fi
    ;;

  show)
    session=$(pick_session "$SESSION_ARG")
    out=$(jq -c --argjson schema "$SCHEMA_VERSION" '. + { schemaVersion: $schema }' <<<"$session" |
          group_session "$EXPAND" | jq -c --arg request "$(jq -r .currentRebootRequest <<<"$ALL")" '
            . + {currentRebootRequest: $request}')
    # An expanded group can outgrow the output cap. Fall back to the collapsed
    # view and say so, rather than printing something the caller must truncate.
    if (( ${#out} > MAX_STDOUT )); then
      out=$(jq -c --argjson schema "$SCHEMA_VERSION" '. + { schemaVersion: $schema }' <<<"$session" |
            group_session "" | jq -c --arg request "$(jq -r .currentRebootRequest <<<"$ALL")" '
              . + {outputTruncated: true, currentRebootRequest: $request}')
    fi
    if (( JSON )); then emit "$out"; else render_show_text <<<"$out"; fi
    ;;

  notes)
    session=$(pick_session "$SESSION_ARG")
    out=$(notes_json "$session")
    # Release bodies are upstream prose of unbounded length. Give each an equal
    # share of the budget and mark any that were shortened.
    if (( ${#out} > MAX_STDOUT )); then
      out=$(jq -c --argjson budget "$(( MAX_STDOUT / 2 ))" '
        (.releases | length) as $n
        | (if $n > 0 then ($budget / $n | floor) else $budget end) as $each
        | .releases |= map(
            if (.body | length) > $each
            then .body = (.body[0:$each] + "\n\u2026") | .bodyTruncated = true
            else . end)
        | .outputTruncated = true' <<<"$out")
    fi
    if (( JSON )); then emit "$out"; else render_notes_text <<<"$out"; fi
    ;;

  compare-url)
    session=$(pick_session "$SESSION_ARG")
    from=$(jq -r '.omarchy.from' <<<"$session")
    to=$(jq -r '.omarchy.to' <<<"$session")
    compare_url "$from" "$to" || die "no Omarchy version change in this session"
    ;;

  status)
    newest=$(jq -c 'if (.sessions | length) > 0 then .sessions[0] else null end' <<<"$ALL")
    newest_id=$(jq -r 'if . == null then "" else .id end' <<<"$newest")
    # Absent and unreadable are different answers. No marker means this is the
    # first run, and sessions that predate the install are not news, so adopt
    # the newest and start quiet. A marker we cannot read means we do not know
    # what has been seen -- and claiming "all read" would swallow a real one,
    # so it counts as unread until the next open rewrites it.
    last=""
    if [[ -e $MARKER ]]; then
      last=$(read_marker || printf '%s' "__unreadable__")
    elif [[ -n $newest_id ]]; then
      write_marker "$newest_id" && last="$newest_id"
    fi

    unread=false
    [[ -n $newest_id && $last != "$newest_id" ]] && unread=true
    # The sentinel is internal; the caller sees "we have no id" instead.
    [[ $last == "__unreadable__" ]] && last=""

    out=$(jq -nc --argjson currentRebootRequest "$(jq .currentRebootRequest <<<"$ALL")" \
                 --argjson schema "$SCHEMA_VERSION" --argjson newest "$newest" \
                 --arg last "$last" --argjson unread "$unread" \
      '{ schemaVersion: $schema,
         newest: (if $newest == null then null
                  else ($newest | del(.events, .groupCounts)) end),
         lastRead: $last, currentRebootRequest: $currentRebootRequest,
         unread: $unread }')

    if (( JSON )); then
      emit "$out"
    elif [[ $newest_id == "" ]]; then
      echo "No update sessions yet."
    elif [[ $unread == true ]]; then
      jq -r '"Unread: \(.newest.label)  \(.newest.omarchy.to)"' <<<"$out"
    else
      jq -r '"Latest recorded session already read: \(.newest.label)"' <<<"$out"
    fi
    ;;

  mark-read)
    # Idempotent, and never the reason a caller fails: the overlay runs this on
    # every open and must not care whether state is writable.
    if (( SESSION_COUNT > 0 )); then
      target=$(jq -r '.id' <<<"$(pick_session "$SESSION_ARG")")
      write_marker "$target" || true
    fi
    exit 0
    ;;

  *) die "unknown command: $CMD (try --help)" ;;
esac
